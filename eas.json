{
  "cli": {
    "version": ">= 4.1.2",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NAILS_EXCLUDE_EXPO_DEV_CLIENT": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NAILS_EXCLUDE_EXPO_DEV_CLIENT": "true"
      }
    },
    "production": {
      "env": {
        "NAILS_EXCLUDE_EXPO_DEV_CLIENT": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
